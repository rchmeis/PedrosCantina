@page
@model PedrosCantina.Pages.Employees.IndexModel
@{
    ViewData["Title"] = "Medarbejderadministration - Pedro's Cantina";
}

@Html.ValidationSummary(false, "", new { @class = "text-danger" })
<div class="container-fluid py-4">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1" style="color: var(--cantina-dark);">Medarbejdere</h2>
            <p class="text-muted mb-0">Administrer personale, kontaktoplysninger og lederrettigheder for Pedro's Cantina.</p>
        </div>
        <button class="btn btn-cantina-primary d-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#createEmployeeModal">
            <i class="bi bi-person-plus-fill"></i>
            <span>Opret Medarbejder</span>
        </button>
    </div>

    <!-- Alert Messages (Success/Error) -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Stat Widgets -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-md-4">
            <div class="cantina-card stat-card">
                <div class="stat-icon" style="background-color: rgba(168, 50, 32, 0.1); color: var(--cantina-primary);">
                    <i class="bi bi-people-fill"></i>
                </div>
                <div>
                    <span class="text-muted small d-block">Totalt Ansat</span>
                    <h4 class="fw-bold mb-0">@Model.Employees.Count</h4>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="cantina-card stat-card">
                <div class="stat-icon" style="background-color: rgba(217, 119, 6, 0.1); color: var(--cantina-accent);">
                    <i class="bi bi-shield-lock-fill"></i>
                </div>
                <div>
                    <span class="text-muted small d-block">Nøglevagter / Ledere</span>
                    <h4 class="fw-bold mb-0">@Model.Employees.Count(e => e.CanActAsLeader)</h4>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="cantina-card stat-card">
                <div class="stat-icon" style="background-color: rgba(34, 197, 94, 0.1); color: #16a34a;">
                    <i class="bi bi-person-check-fill"></i>
                </div>
                <div>
                    <span class="text-muted small d-block">Aktive Vagtplaner</span>
                    <h4 class="fw-bold mb-0">OK</h4>
                </div> 
            </div>
        </div>
    </div>

    <!-- Main Data Table Card -->
    <div class="cantina-card">

        <!-- Table Toolbar med C# GET-formulering -->
        <form method="get" class="p-3 border-bottom d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div class="input-group style-search" style="max-width: 360px;">
                <span class="input-group-text bg-white border-end-0 text-muted">
                    <i class="bi bi-search"></i>
                </span>

                <input type="text"
                       asp-for="SearchTerm"
                       class="form-control border-start-0 ps-0"
                       placeholder="Søg på navn, email eller tlf...">

                <button type="submit" class="btn btn-cantina-primary">
                    Søg
                </button>
            </div>

            <div class="text-muted small">
                Viser <strong>@Model.Employees.Count</strong> medarbejder(e)
            </div>
        </form>
        <!-- Table Toolbar med javascript -->
@*         <div class="p-3 border-bottom d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div class="input-group style-search" style="max-width: 320px;">
                <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                <input type="text" id="searchInput" class="form-control border-start-0 ps-0" placeholder="Søg på navn, email eller tlf...">
            </div>
            <div class="text-muted small">
                Viser <strong>@Model.Employees.Count</strong> medarbejder(e)
            </div>
        </div> *@

        <!-- Table -->
        <div class="table-responsive">
            <table class="table cantina-table align-middle" id="employeeTable">
                <thead>
                    <tr>
                        <th>Medarbejder</th>
                        <th>Kontakt</th>
                        <th>Adresse</th>
                        <th>Rolle</th>
                        <th class="text-end">Handlinger</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var emp in Model.Employees)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    <div class="avatar-circle" style="width: 40px; height: 40px; border-radius: 50%; background-color: var(--cantina-dark); color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 600;">
                                        @(string.IsNullOrEmpty(emp.FirstName) ? "" : emp.FirstName[0].ToString())@(string.IsNullOrEmpty(emp.LastName) ? "" : emp.LastName[0].ToString())
                                    </div>
                                    <div>
                                        <div class="fw-bold text-dark">@emp.FirstName @emp.LastName</div>
                                        <div class="text-muted small">ID: @(emp.Id?.Length >= 8 ? emp.Id.Substring(0, 8) : emp.Id)...</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div><i class="bi bi-envelope text-muted me-1"></i> @emp.Email</div>
                                <div class="text-muted small"><i class="bi bi-telephone text-muted me-1"></i> @emp.PhoneNumber</div>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(emp.Address))
                                {
                                    <span>@emp.Address</span>
                                }
                                else
                                {
                                    <span class="text-muted fst-italic">Ikke opgivet</span>
                                }
                            </td>
                            <td>
                                @if (emp.CanActAsLeader)
                                {
                                    <span class="badge-leader"><i class="bi bi-star-fill me-1"></i> Vagtansvarlig</span>
                                }
                                else
                                {
                                    <span class="badge-staff">Medarbejder</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-light border dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                        Muligheder
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                        <li>
                                            <a class="dropdown-item" asp-page="./Edit" asp-route-id="@emp.Id">
                                                <i class="bi bi-pencil me-2 text-primary"></i> Rediger
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <button type="button" class="dropdown-item text-danger" data-bs-toggle="modal" data-bs-target="#deleteModal-@emp.Id">
                                                <i class="bi bi-trash me-2"></i> Slet
                                            </button>
                                        </li>
                                        <li>
                                            <a asp-page="/Schedule/Monthly" asp-route-employeeId="@emp.Id" class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-calendar-check"></i> Se Vagtplan
                                            </a>
                                        </li>
                                    </ul>
                                </div>

                                <!-- Delete Confirmation Modal -->
                                <div class="modal fade" id="deleteModal-@emp.Id" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content text-start">
                                            <div class="modal-header border-0 pb-0">
                                                <h5 class="modal-title fw-bold text-danger">Slet medarbejder?</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body py-3">
                                                Er du sikker på, at du vil slette <strong>@emp.FirstName @emp.LastName</strong>? Denne handling kan ikke fortrydes.
                                            </div>
                                            <div class="modal-footer border-0 pt-0">
                                                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Annuller</button>
                                                <form method="post" asp-page-handler="Delete" asp-route-id="@emp.Id">
                                                    <button type="submit" class="btn btn-danger">Bekræft sletning</button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal: Opret Medarbejder -->
<div class="modal fade" id="createEmployeeModal" tabindex="-1" aria-labelledby="createEmployeeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header text-white" style="background-color: var(--cantina-dark);">
                <h5 class="modal-title fw-bold" id="createEmployeeModalLabel"><i class="bi bi-person-plus me-2"></i> Opret ny medarbejder</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" asp-page-handler="Create">
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="NewEmployee.FirstName" class="form-label fw-bold small">Fornavn *</label>
                            <input asp-for="NewEmployee.FirstName" class="form-control" placeholder="f.eks. Pedro" required />
                            <span asp-validation-for="NewEmployee.FirstName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="NewEmployee.LastName" class="form-label fw-bold small">Efternavn *</label>
                            <input asp-for="NewEmployee.LastName" class="form-control" placeholder="f.eks. Gonzales" required />
                            <span asp-validation-for="NewEmployee.LastName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="NewEmployee.Email" class="form-label fw-bold small">E-mail *</label>
                            <input asp-for="NewEmployee.Email" type="email" class="form-control" placeholder="pedro@cantina.dk" required />
                            <span asp-validation-for="NewEmployee.Email" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="NewEmployee.PhoneNumber" class="form-label fw-bold small">Telefonnummer *</label>
                            <input asp-for="NewEmployee.PhoneNumber" class="form-control" placeholder="12345678" required />
                            <span asp-validation-for="NewEmployee.PhoneNumber" class="text-danger small"></span>
                        </div>
                        <div class="col-md-12">
                            <label asp-for="NewEmployee.Address" class="form-label fw-bold small">Adresse (Valgfri)</label>
                            <input asp-for="NewEmployee.Address" class="form-control" placeholder="Gadenavn 12, 1. th" />
                        </div>
                        <div class="col-md-12">
                            <label asp-for="NewEmployee.PaymentInfo" class="form-label fw-bold small">Betalingsoplysninger / Reg. & Kontonr. (Valgfri)</label>
                            <input asp-for="NewEmployee.PaymentInfo" class="form-control" placeholder="Reg: 1234 Konto: 123456789" />
                        </div>
                        <div class="col-md-12 mt-3">
                            <div class="form-check form-switch p-3 border rounded-3 bg-light">
                                <input asp-for="NewEmployee.CanActAsLeader" class="form-check-input" type="checkbox" role="switch" id="leaderSwitch">
                                <label class="form-check-label fw-bold ms-2" for="leaderSwitch">
                                    Kan fungere som Shift Leader (Vagtansvarlig)
                                </label>
                                <div class="text-muted small ms-2">Giver medarbejderen tilladelse til at tage ansvarlige vagter i vagtplanen.</div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light border-top-0">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Annuller</button>
                    <button type="submit" class="btn btn-cantina-primary"><i class="bi bi-save me-1"></i> Gem Medarbejder</button>
                </div>
            </form>
        </div>
    </div>
</div>

