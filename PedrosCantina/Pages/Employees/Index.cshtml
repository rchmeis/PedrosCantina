@page
@model PedrosCantina.Pages.Employees.IndexModel
@{
    ViewData["Title"] = "Medarbejderadministration";
}

@Html.ValidationSummary(false, "", new { @class = "text-danger" })

<div class="container-fluid px-4">
    <!-- Overskrift og 'Opret' knap -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1" style="color: var(--text-main);">Medarbejdere</h2>
            <p class="text-muted mb-0">Administrer personale, kontaktoplysninger og lederrettigheder.</p>
        </div>
        <button class="btn btn-primary-custom d-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#createEmployeeModal">
            <i class="bi bi-person-plus-fill"></i>
            <span>Opret Medarbejder</span>
        </button>
    </div>

    <!-- Kvitteringsbesked -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert border-0 shadow-sm mb-4 d-flex align-items-center" style="background-color: var(--success-light); color: #065f46;" role="alert">
            <i class="bi bi-check-circle-fill me-2 fs-5" style="color: var(--success);"></i>
            <div>@TempData["SuccessMessage"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Hovedtabel kort -->
    <div class="dashboard-card">
        <!-- Toolbar med udvidet søgefelt og integrerede stat-bokse -->
        <form method="get" class="p-3 border-bottom d-flex flex-wrap justify-content-between align-items-center gap-3">

            <!-- Udvidet Søgefelt -->
            <div class="search-wrapper flex-grow-1" style="max-width: 520px;">
                <i class="bi bi-search text-muted ms-2 me-1"></i>
                <input type="text"
                       asp-for="SearchTerm"
                       class="form-control"
                       placeholder="Søg på navn, e-mail eller telefon...">
                <button type="submit" class="btn btn-primary-custom btn-sm ms-2">
                    Søg
                </button>
            </div>

            <!-- Kompakte Stat-bokse til højre -->
            <div class="d-flex align-items-center gap-3 flex-wrap">
                <div class="d-flex align-items-center gap-2 px-3 py-2 rounded-3 border bg-light">
                    <div class="stat-icon-box stat-icon-primary" style="width: 36px; height: 36px; font-size: 1rem;">
                        <i class="bi bi-people-fill"></i>
                    </div>
                    <div>
                        <span class="text-muted small d-block lh-1">Totalt ansat</span>
                        <strong class="fs-6" style="color: var(--text-main);">@Model.Employees.Count</strong>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-2 px-3 py-2 rounded-3 border bg-light">
                    <div class="stat-icon-box stat-icon-warning" style="width: 36px; height: 36px; font-size: 1rem;">
                        <i class="bi bi-star-fill"></i>
                    </div>
                    <div>
                        <span class="text-muted small d-block lh-1">Vagtansvarlige</span>
                        <strong class="fs-6" style="color: var(--text-main);">@Model.Employees.Count(e => e.CanActAsLeader)</strong>
                    </div>
                </div>
            </div>

        </form>

        <!-- Tabel -->
        <div class="table-responsive">
            <table class="table table-modern align-middle" id="employeeTable">
                <thead>
                    <tr>
                        <th>Medarbejder</th>
                        <th>Kontakt</th>
                        <th>Adresse</th>
                        <th>Rolle</th>
                        <th class="text-end">Handlinger</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var emp in Model.Employees)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    <div class="avatar-circle">
                                        @(string.IsNullOrEmpty(emp.FirstName) ? "" : emp.FirstName[0].ToString())@(string.IsNullOrEmpty(emp.LastName) ? "" : emp.LastName[0].ToString())
                                    </div>
                                    <div>
                                        <div class="fw-bold" style="color: var(--text-main);">@emp.FirstName @emp.LastName</div>
                                        <div class="text-muted small">ID: @(emp.Id?.Length >= 8 ? emp.Id.Substring(0, 8) : emp.Id)</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div><i class="bi bi-envelope text-muted me-2"></i>@emp.Email</div>
                                <div class="text-muted small"><i class="bi bi-telephone text-muted me-2"></i>@emp.PhoneNumber</div>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(emp.Address))
                                {
                                    <span>@emp.Address</span>
                                }
                                else
                                {
                                    <span class="text-muted fst-italic">Ikke opgivet</span>
                                }
                            </td>
                            <td>
                                @if (emp.CanActAsLeader)
                                {
                                    <span class="badge-role-leader"><i class="bi bi-star-fill"></i> Vagtansvarlig</span>
                                }
                                else
                                {
                                    <span class="badge-role-staff">Medarbejder</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-light border dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                        Handlinger
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                        <li>
                                            <a class="dropdown-item" asp-page="/Schedule/Monthly" asp-route-employeeId="@emp.Id">
                                                <i class="bi bi-calendar-check me-2 text-muted"></i> Se Vagtplan
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-page="./Edit" asp-route-id="@emp.Id">
                                                <i class="bi bi-pencil me-2 text-muted"></i> Rediger
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <button type="button" class="dropdown-item text-danger" data-bs-toggle="modal" data-bs-target="#deleteModal-@emp.Id">
                                                <i class="bi bi-trash me-2"></i> Slet
                                            </button>
                                        </li>
                                    </ul>
                                </div>

                                <!-- Modal: Slet bekræftelse -->
                                <div class="modal fade" id="deleteModal-@emp.Id" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content text-start">
                                            <div class="modal-header modal-header-custom">
                                                <h5 class="modal-title fw-bold">Slet medarbejder?</h5>
                                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body py-4">
                                                Er du sikker på, at du vil slette <strong>@emp.FirstName @emp.LastName</strong>? Denne handling kan ikke fortrydes.
                                            </div>
                                            <div class="modal-footer border-top-0 pt-0">
                                                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Annuller</button>
                                                <form method="post" asp-page-handler="Delete" asp-route-id="@emp.Id">
                                                    <button type="submit" class="btn btn-danger-custom">Bekræft sletning</button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal: Opret Medarbejder -->
<div class="modal fade" id="createEmployeeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header modal-header-custom p-3">
                <h5 class="modal-title fw-bold"><i class="bi bi-person-plus me-2" style="color: var(--brand-primary);"></i> Opret ny medarbejder</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" asp-page-handler="Create">
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="NewEmployee.FirstName" class="form-label fw-bold small">Fornavn *</label>
                            <input asp-for="NewEmployee.FirstName" class="form-control" placeholder="f.eks. Pedro" required />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="NewEmployee.LastName" class="form-label fw-bold small">Efternavn *</label>
                            <input asp-for="NewEmployee.LastName" class="form-control" placeholder="f.eks. Gonzales" required />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="NewEmployee.Email" class="form-label fw-bold small">E-mail *</label>
                            <input asp-for="NewEmployee.Email" type="email" class="form-control" placeholder="pedro@cantina.dk" required />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="NewEmployee.PhoneNumber" class="form-label fw-bold small">Telefonnummer *</label>
                            <input asp-for="NewEmployee.PhoneNumber" class="form-control" placeholder="12345678" required />
                        </div>
                        <div class="col-md-12">
                            <label asp-for="NewEmployee.Address" class="form-label fw-bold small">Adresse (Valgfri)</label>
                            <input asp-for="NewEmployee.Address" class="form-control" placeholder="Gadenavn 12, 1. th" />
                        </div>
                        <div class="col-md-12">
                            <label asp-for="NewEmployee.PaymentInfo" class="form-label fw-bold small">Betalingsoplysninger (Valgfri)</label>
                            <input asp-for="NewEmployee.PaymentInfo" class="form-control" placeholder="Reg: 1234 Konto: 123456789" />
                        </div>
                        <div class="col-md-12 mt-3">
                            <div class="p-3 border rounded-3" style="background-color: var(--warning-light); border-color: rgba(217, 119, 6, 0.3) !important;">
                                <div class="form-check form-switch mb-0">
                                    <input asp-for="NewEmployee.CanActAsLeader" class="form-check-input" type="checkbox" role="switch" id="leaderSwitch">
                                    <label class="form-check-label fw-bold ms-2" for="leaderSwitch">
                                        Kan fungere som Shift Leader (Vagtansvarlig)
                                    </label>
                                </div>
                                <div class="text-muted small ms-4 mt-1">Giver medarbejderen tilladelse til at tage ansvarlige vagter i vagtplanen.</div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light border-top-0">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Annuller</button>
                    <button type="submit" class="btn btn-primary-custom"><i class="bi bi-save me-1"></i> Gem Medarbejder</button>
                </div>
            </form>
        </div>
    </div>
</div>
