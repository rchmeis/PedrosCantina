@page
@model PedrosCantina.Pages.Schedule.MonthlyModel
@{
    ViewData["Title"] = "Månedsplan";
    var nextMonth = Model.Month == 12 ? 1 : Model.Month + 1;
    var nextYear = Model.Month == 12 ? Model.Year + 1 : Model.Year;
    var prevMonth = Model.Month == 1 ? 12 : Model.Month - 1;
    var prevYear = Model.Month == 1 ? Model.Year - 1 : Model.Year;
}

<div class="container-fluid px-3 px-md-4 py-4">

    <!-- Fejlmeddelelse ved oprettelse -->
    @if (TempData["FailCreatePlan"] != null)
    {
        <div class="alert border-0 shadow-sm mb-4 d-flex align-items-center" style="background-color: var(--warning-light); color: var(--warning);" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
            <div>@TempData["FailCreatePlan"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Sidenavigation & Belastnings-bokse -->
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center flex-wrap gap-2 mb-1">
                <h2 class="fw-bold mb-0" style="color: var(--text-main);">Vagtplan: @Model.Month / @Model.Year</h2>
                @if (Model.SelectedEmployee != null)
                {
                    <span class="badge-role-staff">
                        <i class="bi bi-funnel-fill me-1" style="color: var(--brand-primary);"></i> Filtreret: @Model.SelectedEmployee.FirstName @Model.SelectedEmployee.LastName
                    </span>
                }
            </div>
            <p class="text-muted mb-0 small">Klik på en dag for at administrere vagter eller se bemanding.</p>
        </div>

        <!-- Månedsnavigation & Medarbejder-belastning -->
        <div class="d-flex align-items-center gap-2 gap-md-3 flex-wrap">
            <div class="btn-group shadow-sm w-100 w-sm-auto">
                <a asp-page="./Monthly" asp-route-year="@prevYear" asp-route-month="@prevMonth" asp-route-employeeId="@Model.EmployeeId" class="btn btn-light border px-3 flex-fill text-center">
                    <i class="bi bi-chevron-left me-1"></i> Forrige
                </a>
                <a asp-page="./Monthly" asp-route-year="@nextYear" asp-route-month="@nextMonth" asp-route-employeeId="@Model.EmployeeId" class="btn btn-light border px-3 flex-fill text-center">
                    Næste <i class="bi bi-chevron-right ms-1"></i>
                </a>
            </div>

            @if (Model.SelectedEmployee != null)
            {
                <div class="d-flex align-items-center gap-2 flex-wrap w-100 w-sm-auto">
                    <div class="d-flex align-items-center gap-2 px-3 py-2 rounded-3 border bg-white shadow-sm flex-fill">
                        <div class="stat-icon-box stat-icon-primary" style="width: 32px; height: 32px; font-size: 0.9rem;">
                            <i class="bi bi-calendar-event"></i>
                        </div>
                        <div>
                            <span class="text-muted small d-block lh-1" style="font-size: 0.75rem;">Vagter mdr.</span>
                            <strong class="fs-6" style="color: var(--text-main);">@Model.MonthlyWorkload</strong>
                        </div>
                    </div>

                    <div class="d-flex align-items-center gap-2 px-3 py-2 rounded-3 border bg-white shadow-sm flex-fill">
                        <div class="stat-icon-box stat-icon-warning" style="width: 32px; height: 32px; font-size: 0.9rem;">
                            <i class="bi bi-bar-chart-fill"></i>
                        </div>
                        <div>
                            <span class="text-muted small d-block lh-1" style="font-size: 0.75rem;">Vagter år</span>
                            <strong class="fs-6" style="color: var(--text-main);">@Model.YearlyWorkload</strong>
                        </div>
                    </div>

                    <a asp-page="./Monthly" asp-route-year="@Model.Year" asp-route-month="@Model.Month" class="btn btn-outline-secondary btn-sm" title="Nulstil filter">
                        <i class="bi bi-x-lg"></i>
                    </a>
                </div>
            }
        </div>
    </div>

    @if (Model.Plan == null)
    {
        <!-- Tom tilstand -->
        <div class="dashboard-card text-center p-4 p-md-5 my-4">
            <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 64px; height: 64px; background-color: var(--brand-primary-light); color: var(--brand-primary);">
                <i class="bi bi-calendar-plus fs-2"></i>
            </div>
            <h4 class="fw-bold mb-2">Ingen vagtplan for denne måned</h4>
            <p class="text-muted mb-4" style="max-width: 460px; margin: 0 auto;">Der er endnu ikke oprettet en vagtplan for @Model.Month/@Model.Year. Klik nedenfor for at starte en ny plan.</p>

            <form method="post" asp-page-handler="CreatePlan">
                <input type="hidden" name="Year" value="@Model.Year" />
                <input type="hidden" name="Month" value="@Model.Month" />
                <button type="submit" class="btn btn-primary-custom px-4 py-2">
                    <i class="bi bi-magic me-2"></i> Opret Vagtplan Nu
                </button>
            </form>
        </div>
    }
    else
    {
        <!-- Kalender Container med Responsiv Scroll -->
        <div class="dashboard-card p-2 p-md-3">
            <div class="calendar-responsive-wrapper">
                <div class="calendar-grid">
                    <!-- Ugedag overskrifter -->
                    <div class="weekday-header">Man</div>
                    <div class="weekday-header">Tir</div>
                    <div class="weekday-header">Ons</div>
                    <div class="weekday-header">Tor</div>
                    <div class="weekday-header">Fre</div>
                    <div class="weekday-header">Lør</div>
                    <div class="weekday-header">Søn</div>

                    @{
                        int daysInMonth = DateTime.DaysInMonth(Model.Year, Model.Month);
                        DateTime firstDay = new DateTime(Model.Year, Model.Month, 1);
                        int startDayOfWeek = firstDay.DayOfWeek == DayOfWeek.Sunday ? 7 : (int)firstDay.DayOfWeek;

                        for (int i = 1; i < startDayOfWeek; i++)
                        {
                            <div class="calendar-day empty"></div>
                        }

                        foreach (var day in Model.Plan.DayPlans.OrderBy(d => d.Date))
                        {
                            string dateStr = day.Date.ToString("yyyy-MM-dd");
                            bool isDayValid = day.IsRequirementsMet();

                            string cardStyle = "";
                            bool hasMorning = false;
                            bool hasAfternoon = false;

                            if (Model.SelectedEmployee == null)
                            {
                                if (isDayValid)
                                {
                                    cardStyle = "background-color: var(--success-light); border-color: rgba(16, 185, 129, 0.3);";
                                }
                                else
                                {
                                    cardStyle = "background-color: #fef2f2; border-color: rgba(239, 68, 68, 0.3);";
                                }
                            }
                            else
                            {
                                var mShift = day.Shifts.FirstOrDefault(s => s.Type == PedrosCantinaLibrary.Model.ShiftType.Morning);
                                var aShift = day.Shifts.FirstOrDefault(s => s.Type == PedrosCantinaLibrary.Model.ShiftType.Afternoon);

                                if (mShift != null) hasMorning = mShift.Employees.Any(e => e.Id == Model.EmployeeId);
                                if (aShift != null) hasAfternoon = aShift.Employees.Any(e => e.Id == Model.EmployeeId);

                                if (hasMorning || hasAfternoon)
                                {
                                    cardStyle = "background-color: var(--brand-primary-light); border-color: rgba(225, 91, 45, 0.4);";
                                }
                                else
                                {
                                    cardStyle = "background-color: #ffffff; border-color: var(--border-color);";
                                }
                            }

                            <a asp-page="./Day" asp-route-date="@dateStr" asp-route-employeeId="@Model.EmployeeId"
                               class="calendar-day text-decoration-none rounded-3 p-2 d-flex flex-column position-relative"
                               style="@cardStyle">

                                <!-- Øverste række: Dag-tal & Grønt godkendt-ikon i højre hjørne -->
                                <div class="d-flex justify-content-between align-items-start mb-1">
                                    <span class="day-number fw-bold">@day.Date.Day</span>
                                    @if (Model.SelectedEmployee == null && isDayValid)
                                    {
                                        <i class="bi bi-check-circle-fill" style="color: var(--success); font-size: 0.85rem;" title="Bemanding godkendt"></i>
                                    }
                                </div>

                                @if (Model.SelectedEmployee != null)
                                {
                                    if (hasMorning || hasAfternoon)
                                    {
                                        <div class="mt-auto d-flex gap-1 justify-content-center pb-1">
                                            @if (hasMorning)
                                            {
                                                <div class="shift-dot morning-dot" title="Morgenvagt (09-14)"></div>
                                            }
                                            @if (hasAfternoon)
                                            {
                                                <div class="shift-dot afternoon-dot" title="Aftenvagt (14-19)"></div>
                                            }
                                        </div>
                                    }
                                }
                                else
                                {
                                    if (isDayValid)
                                    {
                                        var morning = day.Shifts.FirstOrDefault(s => s.Type == PedrosCantinaLibrary.Model.ShiftType.Morning);
                                        var afternoon = day.Shifts.FirstOrDefault(s => s.Type == PedrosCantinaLibrary.Model.ShiftType.Afternoon);

                                        int morningCount = morning?.Employees.Count ?? 0;
                                        int afternoonCount = afternoon?.Employees.Count ?? 0;

                                        <div class="mt-auto d-flex flex-column text-start pb-1 px-1" style="font-size: 0.72rem; line-height: 1.35; color: #065f46;">
                                            <span class="fw-medium text-truncate">
                                                <i class="bi bi-sun me-1"></i>Morgen: @morningCount
                                            </span>
                                            <span class="fw-medium text-truncate">
                                                <i class="bi bi-moon me-1"></i>Aften: @afternoonCount
                                            </span>

                                            @if (!string.IsNullOrWhiteSpace(day.Note))
                                            {
                                                <span class="text-muted fst-italic mt-1 border-top pt-1"
                                                      style="font-size: 0.68rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; word-break: break-word;"
                                                      title="@day.Note">
                                                    <i class="bi bi-chat-left-text me-1"></i>@day.Note
                                                </span>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="mt-auto d-flex flex-column text-start" style="font-size: 0.72rem; line-height: 1.3; color: var(--danger);">
                                            <span class="fw-bold border-bottom pb-1 mb-1" style="border-color: rgba(239, 68, 68, 0.2) !important;">Mangler:</span>
                                            @{
                                                var m = day.Shifts.FirstOrDefault(s => s.Type == PedrosCantinaLibrary.Model.ShiftType.Morning);
                                                var a = day.Shifts.FirstOrDefault(s => s.Type == PedrosCantinaLibrary.Model.ShiftType.Afternoon);

                                                if (m == null || m.Employees.Count < 2)
                                                {
                                                    <span class="text-truncate fw-medium"><i class="bi bi-sun me-1"></i>Morgen</span>
                                                }
                                                else if (!m.Employees.Any(e => e.CanActAsLeader))
                                                {
                                                    <span class="text-truncate fw-medium"><i class="bi bi-sun me-1"></i>Morgen (Leder)</span>
                                                }

                                                if (a == null || a.Employees.Count < 2)
                                                {
                                                    <span class="text-truncate fw-medium"><i class="bi bi-moon me-1"></i>Aften</span>
                                                }
                                                else if (!a.Employees.Any(e => e.CanActAsLeader))
                                                {
                                                    <span class="text-truncate fw-medium"><i class="bi bi-moon me-1"></i>Aften (Leder)</span>
                                                }
                                            }
                                        </div>
                                    }
                                }
                            </a>
                        }
                    }
                </div>
            </div>
        </div>
    }
</div>