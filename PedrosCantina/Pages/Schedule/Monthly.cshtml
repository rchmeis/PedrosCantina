@page
@model PedrosCantina.Pages.Schedule.MonthlyModel
@{
    ViewData["Title"] = "Månedsplan";
    var nextMonth = Model.Month == 12 ? 1 : Model.Month + 1;
    var nextYear = Model.Month == 12 ? Model.Year + 1 : Model.Year;
    var prevMonth = Model.Month == 1 ? 12 : Model.Month - 1;
    var prevYear = Model.Month == 1 ? Model.Year - 1 : Model.Year;
}

<style>
    /* Sikrer at dropdown-menuer altid ligger oven på underliggende kalenderdage */
    .calendar-day {
        position: relative;
        transition: z-index 0.1s ease;
    }

        .calendar-day:hover,
        .calendar-day:focus-within {
            z-index: 100 !important;
        }

        .calendar-day .dropdown-menu {
            z-index: 1050 !important;
        }
</style>

<div class="container-fluid px-3 px-md-4 py-4">

    <!-- Meddelelser & Advarsler -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm mb-4 d-flex align-items-center alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2 fs-5"></i>
            <div>@TempData["SuccessMessage"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["FailCreatePlan"] != null)
    {
        <div class="alert border-0 shadow-sm mb-4 d-flex align-items-center" style="background-color: var(--warning-light); color: var(--warning);" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
            <div>@TempData["FailCreatePlan"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["SearchWarning"] != null)
    {
        <div class="alert border-0 shadow-sm mb-4 d-flex align-items-center alert-dismissible fade show" style="background-color: var(--warning-light); color: var(--warning);" role="alert">
            <i class="bi bi-search me-2 fs-5"></i>
            <div>@TempData["SearchWarning"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Header & Navigation -->
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-stretch gap-3 mb-4">

        <!-- Venstre sektion -->
        <div class="d-flex flex-column justify-content-between gap-2 flex-grow-1" style="max-width: 520px; width: 100%;">
            <div class="d-flex align-items-center flex-wrap gap-2">
                <h2 class="fw-bold mb-0" style="color: var(--text-main);">Vagtplan: @Model.Month / @Model.Year</h2>
                @if (Model.SelectedEmployee != null)
                {
                    <span class="badge-role-staff d-inline-flex align-items-center gap-2 ps-2 pe-1 py-1 shadow-sm" style="border: 1px solid rgba(225, 91, 45, 0.2);">
                        <i class="bi bi-funnel-fill" style="color: var(--brand-primary);"></i>
                        <span>Filtreret: @Model.SelectedEmployee.FirstName @Model.SelectedEmployee.LastName</span>
                        <a asp-page="./Monthly" asp-route-year="@Model.Year" asp-route-month="@Model.Month"
                           class="d-inline-flex align-items-center justify-content-center text-muted text-decoration-none rounded-circle bg-white-hover"
                           style="width: 20px; height: 20px; transition: all 0.2s ease;"
                           title="Nulstil filter">
                            <i class="bi bi-x-lg" style="font-size: 0.75rem;"></i>
                        </a>
                    </span>
                }
            </div>

            <p class="text-muted mb-0 small">Søg en medarbejder eller klik på en dag for at administrere vagter.</p>

            <form method="get" class="d-flex align-items-center w-100 mt-1">
                <input type="hidden" name="year" value="@Model.Year" />
                <input type="hidden" name="month" value="@Model.Month" />
                <div class="search-wrapper px-2 py-1 w-100">
                    <i class="bi bi-search text-muted me-2"></i>
                    <input type="text"
                           name="searchTerm"
                           value="@Model.SearchTerm"
                           placeholder="Søg navn eller tlf..."
                           class="form-control form-control-sm py-1 border-0 bg-transparent" />
                    @if (!string.IsNullOrEmpty(Model.SearchTerm) || Model.SelectedEmployee != null)
                    {
                        <a asp-page="./Monthly" asp-route-year="@Model.Year" asp-route-month="@Model.Month" class="text-muted ms-1 text-decoration-none" title="Nulstil søgning">
                            <i class="bi bi-x-circle-fill"></i>
                        </a>
                    }
                </div>
            </form>
        </div>

        <!-- Højre sektion -->
        <div class="d-flex flex-column align-items-lg-end justify-content-between ms-lg-auto gap-3">
            @if (Model.SelectedEmployee != null)
            {
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <div class="d-flex align-items-center gap-3 px-3 py-2 rounded-3 border bg-white shadow-sm" style="min-width: 150px;">
                        <div class="stat-icon-box stat-icon-primary" style="width: 40px; height: 40px; font-size: 1.1rem; border-radius: 10px;">
                            <i class="bi bi-calendar-event"></i>
                        </div>
                        <div>
                            <span class="text-muted small d-block lh-1 mb-1" style="font-size: 0.72rem; font-weight: 500;">Vagter mdr.</span>
                            <strong class="fs-5 lh-1" style="color: var(--text-main);">@Model.MonthlyWorkload</strong>
                        </div>
                    </div>

                    <div class="d-flex align-items-center gap-3 px-3 py-2 rounded-3 border bg-white shadow-sm" style="min-width: 150px;">
                        <div class="stat-icon-box stat-icon-warning" style="width: 40px; height: 40px; font-size: 1.1rem; border-radius: 10px;">
                            <i class="bi bi-bar-chart-fill"></i>
                        </div>
                        <div>
                            <span class="text-muted small d-block lh-1 mb-1" style="font-size: 0.72rem; font-weight: 500;">Vagter år</span>
                            <strong class="fs-5 lh-1" style="color: var(--text-main);">@Model.YearlyWorkload</strong>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div></div>
            }

            <div class="btn-group shadow-sm">
                <a asp-page="./Monthly" asp-route-year="@prevYear" asp-route-month="@prevMonth" asp-route-employeeId="@Model.EmployeeId" asp-route-searchTerm="@Model.SearchTerm" class="btn btn-light border px-3 py-2">
                    <i class="bi bi-chevron-left me-1"></i> Forrige
                </a>
                <a asp-page="./Monthly" asp-route-year="@nextYear" asp-route-month="@nextMonth" asp-route-employeeId="@Model.EmployeeId" asp-route-searchTerm="@Model.SearchTerm" class="btn btn-light border px-3 py-2">
                    Næste <i class="bi bi-chevron-right ms-1"></i>
                </a>
            </div>
        </div>
    </div>

    @if (Model.Plan == null)
    {
        <div class="dashboard-card text-center p-4 p-md-5 my-4">
            <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 64px; height: 64px; color: var(--brand-primary);">
                <i class="bi bi-calendar-plus fs-2"></i>
            </div>
            <h4 class="fw-bold mb-2">Ingen vagtplan for denne måned</h4>
            <p class="text-muted mb-4" style="max-width: 460px; margin: 0 auto;">Der er endnu ikke oprettet en vagtplan for @Model.Month/@Model.Year. Klik nedenfor for at starte en ny plan.</p>

            <form method="post" asp-page-handler="CreatePlan">
                <input type="hidden" name="Year" value="@Model.Year" />
                <input type="hidden" name="Month" value="@Model.Month" />
                <button type="submit" class="btn btn-primary-custom px-4 py-2">
                    <i class="bi bi-magic me-2"></i> Opret Vagtplan Nu
                </button>
            </form>
        </div>
    }
    else
    {
        <div class="dashboard-card p-2 p-md-3">
            <div class="calendar-responsive-wrapper">
                <div class="calendar-grid">
                    <div class="weekday-header">Man</div>
                    <div class="weekday-header">Tir</div>
                    <div class="weekday-header">Ons</div>
                    <div class="weekday-header">Tor</div>
                    <div class="weekday-header">Fre</div>
                    <div class="weekday-header">Lør</div>
                    <div class="weekday-header">Søn</div>

                    @{
                        int daysInMonth = DateTime.DaysInMonth(Model.Year, Model.Month);
                        DateTime firstDay = new DateTime(Model.Year, Model.Month, 1);
                        int startDayOfWeek = firstDay.DayOfWeek == DayOfWeek.Sunday ? 7 : (int)firstDay.DayOfWeek;

                        string GetInitials(PedrosCantinaLibrary.Model.Employee e)
                        {
                            if (e == null) return "";
                            string first = !string.IsNullOrEmpty(e.FirstName) ? e.FirstName[0].ToString() : "";
                            string last = !string.IsNullOrEmpty(e.LastName) ? e.LastName[0].ToString() : "";
                            return (first + last).ToUpper();
                        }

                        for (int i = 1; i < startDayOfWeek; i++)
                        {
                            <div class="calendar-day empty"></div>
                        }

                        foreach (var day in Model.Plan.DayPlans.OrderBy(d => d.Date))
                        {
                            string dateStr = day.Date.ToString("yyyy-MM-dd");
                            bool isDayValid = day.IsRequirementsMet();

                            var morning = day.Shifts.FirstOrDefault(s => s.Type == PedrosCantinaLibrary.Model.ShiftType.Morning);
                            var afternoon = day.Shifts.FirstOrDefault(s => s.Type == PedrosCantinaLibrary.Model.ShiftType.Afternoon);

                            bool hasMorning = Model.SelectedEmployee != null && morning != null && morning.Employees.Any(e => e.Id == Model.SelectedEmployee.Id);
                            bool hasAfternoon = Model.SelectedEmployee != null && afternoon != null && afternoon.Employees.Any(e => e.Id == Model.SelectedEmployee.Id);

                            // FÆLLES FARVELOGIK: samme baggrund uanset om en medarbejder er valgt eller ej
                            string cardStyle = isDayValid
                                ? "background-color: var(--success-light); border-color: rgba(16, 185, 129, 0.3);"
                                : "background-color: #fef2f2; border-color: rgba(239, 68, 68, 0.3);";

                                //JUSTERING MED BORDER OMKRING KORTET VED MEDARBEJDER VIEW. 
                            if (Model.SelectedEmployee != null && (hasMorning || hasAfternoon))
                            {
                                cardStyle += " border-top: 4px solid var(--brand-primary);";
                            }

                            string morningFullNames = morning != null && morning.Employees.Any()
                                ? "Morgenvagt: " + string.Join(", ", morning.Employees.Select(e => e.FirstName + " " + e.LastName + (e.CanActAsLeader ? " (Leder)" : "")))
                                : "Morgenvagt: Ingen booket";

                            string afternoonFullNames = afternoon != null && afternoon.Employees.Any()
                                ? "Aftenvagt: " + string.Join(", ", afternoon.Employees.Select(e => e.FirstName + " " + e.LastName + (e.CanActAsLeader ? " (Leder)" : "")))
                                : "Aftenvagt: Ingen booket";

                            // FÆLLES CHECK-IKON: bruges i begge views
                            string checkIconHtml = isDayValid
                                ? "<i class=\"bi bi-check-circle-fill\" style=\"color: var(--success); font-size: 0.85rem;\" title=\"Bemanding godkendt\"></i>"
                                : "";

                            if (Model.SelectedEmployee == null)
                            {
                                <!-- GENERELT VIEW: HELE DAGSKORTET ER ET KLIKBART LINK TIL DAY.CSHTML -->
                                <a asp-page="./Day" asp-route-date="@dateStr" asp-route-employeeId="@Model.EmployeeId"
                                   class="calendar-day text-decoration-none rounded-3 p-2 d-flex flex-column"
                                   style="@cardStyle">

                                    <!-- Øverste række: Dag-tal & Bemandingsstatus -->
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="day-number fw-bold text-dark">@day.Date.Day</span>
                                        @Html.Raw(checkIconHtml)
                                    </div>

                                    <!-- Midterste del: Initialer for medarbejdere -->
                                    <div class="my-auto d-flex flex-column text-start py-1 px-1" style="font-size: 0.75rem; line-height: 1.4;">
                                        <!-- Morgenvagt -->
                                        <div class="text-truncate" style="color: var(--text-main);" title="@morningFullNames">
                                            <i class="bi bi-sun me-1" style="color: var(--warning);"></i>
                                            @if (morning != null && morning.Employees.Any())
                                            {
                                                var empList = morning.Employees.ToList();
                                                for (int idx = 0; idx < empList.Count; idx++)
                                                {
                                                    var emp = empList[idx];
                                                    var initials = GetInitials(emp);
                                                    if (emp.CanActAsLeader)
                                                    {
                                                        <strong class="fw-bold" title="@emp.FirstName @emp.LastName (Vagtansvarlig)">@initials</strong>
                                                    }
                                                    else
                                                    {
                                                        <span class="fw-normal opacity-85">@initials</span>
                                                    }
                                                    if (idx < empList.Count - 1)
                                                    {
                                                        <span>, </span>
                                                    }
                                                }
                                            }
                                            else
                                            {
                                                <span class="fst-italic opacity-50">-</span>
                                            }
                                        </div>

                                        <!-- Aftenvagt -->
                                        <div class="text-truncate" style="color: var(--text-main);" title="@afternoonFullNames">
                                            <i class="bi bi-moon me-1" style="color: var(--nav-bg);"></i>
                                            @if (afternoon != null && afternoon.Employees.Any())
                                            {
                                                var empList = afternoon.Employees.ToList();
                                                for (int idx = 0; idx < empList.Count; idx++)
                                                {
                                                    var emp = empList[idx];
                                                    var initials = GetInitials(emp);
                                                    if (emp.CanActAsLeader)
                                                    {
                                                        <strong class="fw-bold" title="@emp.FirstName @emp.LastName (Vagtansvarlig)">@initials</strong>
                                                    }
                                                    else
                                                    {
                                                        <span class="fw-normal opacity-85">@initials</span>
                                                    }
                                                    if (idx < empList.Count - 1)
                                                    {
                                                        <span>, </span>
                                                    }
                                                }
                                            }
                                            else
                                            {
                                                <span class="fst-italic opacity-50">-</span>
                                            }
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(day.Note))
                                        {
                                            <span class="text-muted fst-italic mt-1 border-top pt-1"
                                                  style="font-size: 0.68rem; display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden; word-break: break-word;"
                                                  title="@day.Note">
                                                <i class="bi bi-chat-left-text me-1"></i>@day.Note
                                            </span>
                                        }
                                    </div>
                                </a>
                            }
                            else
                            {
                                <!-- MEDARBEJDER VIEW: DIV CONTAINER MED INTERAKTIVE KNAPPER -->
                                <div class="calendar-day rounded-3 p-2 d-flex flex-column" style="@cardStyle">

                                    <!-- Øverste række: Klikbart Dag-tal & Bemandingsstatus -->
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <a asp-page="./Day" asp-route-date="@dateStr" asp-route-employeeId="@Model.EmployeeId"
                                           class="day-number fw-bold text-decoration-none text-dark" title="Gå til dagsplan">
                                            @day.Date.Day
                                        </a>
                                        @Html.Raw(checkIconHtml)
                                    </div>

                                    <!-- Midterste del: Initialer (Valgt medarbejder fremhævet i gul cirkel) -->
                                    <div class="my-auto d-flex flex-column text-start py-1 px-1" style="font-size: 0.75rem; line-height: 1.4;">

                                        <!-- Morgenvagt -->
                                        <div class="text-truncate" style="color: var(--text-main);" title="@morningFullNames">
                                            <i class="bi bi-sun me-1" style="color: var(--warning);"></i>
                                            @if (morning != null && morning.Employees.Any())
                                            {
                                                var empList = morning.Employees.ToList();
                                                for (int idx = 0; idx < empList.Count; idx++)
                                                {
                                                    var emp = empList[idx];
                                                    var initials = GetInitials(emp);
                                                 
                                                    if (emp.CanActAsLeader)
                                                    {
                                                        <strong class="fw-bold" title="@emp.FirstName @emp.LastName (Vagtansvarlig)">@initials</strong>
                                                    }
                                                    else
                                                    {
                                                        <span class="fw-normal opacity-85">@initials</span>
                                                    }

                                                    if (idx < empList.Count - 1)
                                                    {
                                                        <span>, </span>
                                                    }
                                                }
                                            }
                                            else
                                            {
                                                <span class="fst-italic opacity-50">-</span>
                                            }
                                        </div>

                                        <!-- Aftenvagt -->
                                        <div class="text-truncate" style="color: var(--text-main);" title="@afternoonFullNames">
                                            <i class="bi bi-moon me-1" style="color: var(--nav-bg);"></i>
                                            @if (afternoon != null && afternoon.Employees.Any())
                                            {
                                                var empList = afternoon.Employees.ToList();
                                                for (int idx = 0; idx < empList.Count; idx++)
                                                {
                                                    var emp = empList[idx];
                                                    var initials = GetInitials(emp);
                                                 
                                                    if (emp.CanActAsLeader)
                                                    {
                                                        <strong class="fw-bold" title="@emp.FirstName @emp.LastName (Vagtansvarlig)">@initials</strong>
                                                    }
                                                    else
                                                    {
                                                        <span class="fw-normal opacity-85">@initials</span>
                                                    }

                                                    if (idx < empList.Count - 1)
                                                    {
                                                        <span>, </span>
                                                    }
                                                }
                                            }
                                            else
                                            {
                                                <span class="fst-italic opacity-50">-</span>
                                            }
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(day.Note))
                                        {
                                            <span class="text-muted fst-italic mt-1 border-top pt-1"
                                                  style="font-size: 0.68rem; display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden; word-break: break-word;"
                                                  title="@day.Note">
                                                <i class="bi bi-chat-left-text me-1"></i>@day.Note
                                            </span>
                                        }
                                    </div>

                                    <!-- Nederste del: Knapper låst til 50% bredde hver -->
                                    <div class="mt-auto pt-1 d-flex gap-1 w-100">

                                        <!-- Grøn Tilføj (+) Knap (Fast 50% bredde) -->
                                        <div class="dropdown" style="width: 50%;">
                                            <button class="btn btn-sm w-100 py-1 px-0 d-flex align-items-center justify-content-center shadow-sm action-btn"
                                                    type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Tilføj til vagt">
                                                <i class="bi bi-plus-lg" style="font-size: 0.8rem;"></i>
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-end shadow-sm" style="font-size: 0.75rem;">
                                                @if (morning != null)
                                                {
                                                    <li>
                                                        <form method="post" asp-page-handler="AddShift">
                                                            <input type="hidden" name="shiftId" value="@morning.Id" />
                                                            <input type="hidden" name="employeeId" value="@Model.SelectedEmployee.Id" />
                                                            <input type="hidden" name="year" value="@Model.Year" />
                                                            <input type="hidden" name="month" value="@Model.Month" />
                                                            <input type="hidden" name="searchTerm" value="@Model.SearchTerm" />
                                                            <button type="submit" class="dropdown-item py-1">
                                                                <i class="bi bi-sun text-warning me-1"></i> Morgenvagt
                                                            </button>
                                                        </form>
                                                    </li>
                                                }
                                                @if (afternoon != null)
                                                {
                                                    <li>
                                                        <form method="post" asp-page-handler="AddShift">
                                                            <input type="hidden" name="shiftId" value="@afternoon.Id" />
                                                            <input type="hidden" name="employeeId" value="@Model.SelectedEmployee.Id" />
                                                            <input type="hidden" name="year" value="@Model.Year" />
                                                            <input type="hidden" name="month" value="@Model.Month" />
                                                            <input type="hidden" name="searchTerm" value="@Model.SearchTerm" />
                                                            <button type="submit" class="dropdown-item py-1">
                                                                <i class="bi bi-moon me-1"></i> Aftenvagt
                                                            </button>
                                                        </form>
                                                    </li>
                                                }
                                            </ul>
                                        </div>

                                        <!-- Rød Slet (Skraldespand) Knap (Fast 50% bredde når til stede) -->
                                        @if (hasMorning || hasAfternoon)
                                        {
                                            <div class="dropdown" style="width: 50%;">
                                                <button class="btn btn-sm w-100 py-1 px-0 d-flex align-items-center justify-content-center shadow-sm action-btn"
                                                        type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Fjern fra vagt">
                                                    <i class="bi bi-trash-fill" style="font-size: 0.75rem;"></i>
                                                </button>
                                                <ul class="dropdown-menu dropdown-menu-end shadow-sm" style="font-size: 0.75rem;">
                                                    @if (hasMorning && morning != null)
                                                    {
                                                        <li>
                                                            <form method="post" asp-page-handler="RemoveShift">
                                                                <input type="hidden" name="shiftId" value="@morning.Id" />
                                                                <input type="hidden" name="employeeId" value="@Model.SelectedEmployee.Id" />
                                                                <input type="hidden" name="year" value="@Model.Year" />
                                                                <input type="hidden" name="month" value="@Model.Month" />
                                                                <input type="hidden" name="searchTerm" value="@Model.SearchTerm" />
                                                                <button type="submit" class="dropdown-item text-danger py-1">
                                                                    <i class="bi bi-sun text-warning me-1"></i> Morgenvagt
                                                                </button>
                                                            </form>
                                                        </li>
                                                    }
                                                    @if (hasAfternoon && afternoon != null)
                                                    {
                                                        <li>
                                                            <form method="post" asp-page-handler="RemoveShift">
                                                                <input type="hidden" name="shiftId" value="@afternoon.Id" />
                                                                <input type="hidden" name="employeeId" value="@Model.SelectedEmployee.Id" />
                                                                <input type="hidden" name="year" value="@Model.Year" />
                                                                <input type="hidden" name="month" value="@Model.Month" />
                                                                <input type="hidden" name="searchTerm" value="@Model.SearchTerm" />
                                                                <button type="submit" class="dropdown-item text-danger py-1">
                                                                    <i class="bi bi-moon me-1"></i> Aftenvagt
                                                                </button>
                                                            </form>
                                                        </li>
                                                    }
                                                </ul>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        }
                    }
                </div>
            </div>
        </div>
    }
</div>