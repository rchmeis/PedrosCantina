@page
@model IndexModel
@{
    ViewData["Title"] = "Forside";
    var todayStr = DateTime.Now.ToString("yyyy-MM-dd");
    var formattedDate = DateTime.Now.ToString("dddd d. MMMM yyyy", new System.Globalization.CultureInfo("da-DK"));
}

<!-- Hero Banner (Fuldbredde baggrund, men centreret indhold) -->
<!-- Hero Banner -->
<!-- Hero Banner -->
<div class="position-relative overflow-hidden text-white d-flex align-items-center py-5 mb-4"
     style="background: linear-gradient(135deg, var(--nav-bg) 0%, #2a2d38 100%); margin-top: -2rem; min-height: 45vh; border-bottom: 1px solid rgba(255, 255, 255, 0.08);">

    <!-- Indholdscentrering begrænset til max 1400px -->
    <div class="container-fluid px-4 position-relative">

        <!-- Tekst & Knapper (z-index 2 så teksten ligger øverst) -->
        <div class="position-relative" style="z-index: 2;">
            <h1 class="fw-bold display-5 mb-2">Velkommen, Pedro</h1>
            <p class="text-white-50 lead mb-4" style="max-width: 600px; font-size: 1.1rem;">
                Få det fulde overblik over månedens vagter, dagens bemanding og medarbejdere på ét samlet sted.
            </p>
            <div class="d-flex flex-wrap gap-3">
                <a asp-page="/Schedule/Day" asp-route-date="@todayStr" class="btn btn-primary-custom d-inline-flex align-items-center gap-2">
                    <i class="bi bi-sun-fill"></i>
                    <span>Åbn Dagsplan for i dag</span>
                </a>
                <a asp-page="/Schedule/Monthly" class="btn btn-outline-light d-inline-flex align-items-center gap-2">
                    <i class="bi bi-calendar3"></i>
                    <span>Se Månedsplan</span>
                </a>
            </div>
        </div>

        <!-- Subtilt baggrundsikon - Aligned med indholdets højre margin (1.5rem / px-4) -->
        <i class="bi bi-cup-hot position-absolute text-white d-none d-sm-block"
           style="font-size: 16rem; right: 1.5rem; top: 50%; transform: translateY(-45%); opacity: 0.04; pointer-events: none; z-index: 1;"></i>

    </div>
</div>

<!-- Sidens øvrige indhold -->
<div class="container-fluid px-4">

    <!-- Hovedmoduler & Hurtigadgang -->
    <h2 class="fw-bold mb-3" style="color: var(--text-main);">Værktøjer</h2>

    <div class="row g-4 mb-4">
        <!-- Kort 1: Månedsplan -->
        <div class="col-12 col-md-4">
            <div class="dashboard-card h-100 d-flex flex-column p-4">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="stat-icon-box stat-icon-primary" style="width: 42px; height: 42px;">
                        <i class="bi bi-calendar-month"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-0" style="color: var(--text-main);">Månedsplan</h6>
                        <span class="text-muted small">Månedligt overblik og vagtoprettelse</span>
                    </div>
                </div>
                <p class="text-muted small mb-4 flex-grow-1">
                    Se hele månedens vagtplan i et overskueligt kalendergrid. Tjek bemandingsmangler og filtrer på enkeltpersoner.
                </p>
                <a asp-page="/Schedule/Monthly" class="btn btn-light border w-100 d-flex align-items-center justify-content-center gap-2">
                    <span>Gå til Månedsplan</span>
                    <i class="bi bi-chevron-right small"></i>
                </a>
            </div>
        </div>

        <!-- Kort 2: Dagsplan -->
        <div class="col-12 col-md-4">
            <div class="dashboard-card h-100 d-flex flex-column p-4">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="stat-icon-box stat-icon-warning" style="width: 42px; height: 42px;">
                        <i class="bi bi-clock-history"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-0" style="color: var(--text-main);">Dagsplan & Vagter</h6>
                        <span class="text-muted small">Tildeling og notater</span>
                    </div>
                </div>
                <p class="text-muted small mb-4 flex-grow-1">
                    Administrer dagens morgen- og aftenvagter. Tilføj eller fjern medarbejdere samt noter om særlige arrangementer.
                </p>
                <a asp-page="/Schedule/Day" asp-route-date="@todayStr" class="btn btn-light border w-100 d-flex align-items-center justify-content-center gap-2">
                    <span>Gå til Dagsplan (I dag)</span>
                    <i class="bi bi-chevron-right small"></i>
                </a>
            </div>
        </div>

        <!-- Kort 3: Medarbejderadmin -->
        <div class="col-12 col-md-4">
            <div class="dashboard-card h-100 d-flex flex-column p-4">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="stat-icon-box stat-icon-success" style="width: 42px; height: 42px;">
                        <i class="bi bi-person-lines-fill"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-0" style="color: var(--text-main);">Medarbejdere</h6>
                        <span class="text-muted small">Kartotek og vagtansvar</span>
                    </div>
                </div>
                <p class="text-muted small mb-4 flex-grow-1">
                    Opret og rediger medarbejderoplysninger, kontaktdetaljer samt tildeling af Shift Leader-rettigheder.
                </p>
                <a asp-page="/Employees/Index" class="btn btn-light border w-100 d-flex align-items-center justify-content-center gap-2">
                    <span>Administrer Medarbejdere</span>
                    <i class="bi bi-chevron-right small"></i>
                </a>
            </div>
        </div>
    </div>

    <!-- Info boks / Tips -->
    <div class="dashboard-card p-4 mb-4" style="background-color: var(--brand-primary-light); border-color: rgba(225, 91, 45, 0.2);">
        <div class="d-flex align-items-start gap-3">
            <div class="stat-icon-box stat-icon-primary flex-shrink-0">
                <i class="bi bi-info-circle-fill"></i>
            </div>
            <div>
                <h6 class="fw-bold mb-1" style="color: var(--brand-primary-hover);">Nyttigt tip til vagtplanlægning</h6>
                <p class="text-muted small mb-0">
                    Når du klikker på en medarbejder inde fra <strong>Medarbejderadministrationen</strong>, bliver du omstillet til Månedsplanen i filtreret tilstand, hvor du nemt kan aflæse medarbejderens månedlige og årlige arbejdsbelastning.
                </p>
            </div>
        </div>
    </div>
</div>